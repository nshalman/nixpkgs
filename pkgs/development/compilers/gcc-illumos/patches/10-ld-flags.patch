From: SmartOS-recipe adaptation of OmniOS 1000-ld-flags.patch
Original-Author: Andy Fiddaman <omnios@citrus-it.co.uk>
Subject: Adjust default library paths for nix-store install prefix (GCC 10)

The OmniOS/SmartOS GCC build patches gcc/config/sol2.h to point
LINK_ARCH{32,64}_SPEC_BASE at /usr/gcc/<MAJOR>/lib (their install
convention). For Nix we want the libraries to be looked up under
$out instead. The token @NIX_GCC_PREFIX@ is replaced with the
actual store path at build time (postPatch / substituteInPlace).

This is the GCC-10 variant — sol2.h's context (ENDFILE_SPEC line)
differs from GCC-14, so the gcc-14 variant of this patch won't apply
cleanly here.
---
 gcc/config/sol2.h | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

--- a/gcc/config/sol2.h
+++ b/gcc/config/sol2.h
@@ -304,12 +304,12 @@
   "%{Ofast|ffast-math|funsafe-math-optimizations:crtfastmath.o%s} \
    %(endfile_arch) %(endfile_vtv) %(endfile_crtend) crtn.o%s"
 
+/* Nix-store install prefix substituted at build time (postPatch). */
 #undef LINK_ARCH32_SPEC_BASE
 #define LINK_ARCH32_SPEC_BASE \
   "%{YP,*} \
    %{R*} \
-   %{!YP,*:%{p|pg:-Y P,%R/usr/lib/libp%R/lib:%R/usr/lib} \
-	   %{!p:%{!pg:-Y P,%R/lib:%R/usr/lib}}}"
+   %{!YP,*:-Y P,%R@NIX_GCC_PREFIX@/lib:%R/lib:%R/usr/lib -L %R@NIX_GCC_PREFIX@/lib -R %R@NIX_GCC_PREFIX@/lib}"
 
 #undef LINK_ARCH32_SPEC
 #define LINK_ARCH32_SPEC LINK_ARCH32_SPEC_BASE
@@ -320,8 +320,7 @@
 #define LINK_ARCH64_SPEC_BASE \
   "%{YP,*} \
    %{R*} \
-   %{!YP,*:%{p|pg:-Y P,%R/usr/lib/libp/" ARCH64_SUBDIR ":%R/lib/" ARCH64_SUBDIR ":%R/usr/lib/" ARCH64_SUBDIR "}	\
-	   %{!p:%{!pg:-Y P,%R/lib/" ARCH64_SUBDIR ":%R/usr/lib/" ARCH64_SUBDIR "}}}"
+   %{!YP,*:-Y P,%R@NIX_GCC_PREFIX@/lib/" ARCH64_SUBDIR ":%R/lib/" ARCH64_SUBDIR ":%R/usr/lib/" ARCH64_SUBDIR " -L %R@NIX_GCC_PREFIX@/lib/" ARCH64_SUBDIR " -R %R@NIX_GCC_PREFIX@/lib/" ARCH64_SUBDIR "}"
 
 #undef LINK_ARCH64_SPEC
 #ifndef USE_GLD
