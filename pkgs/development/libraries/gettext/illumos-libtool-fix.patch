Remove -export-symbols-regex from libtool invocations on illumos.

libtool's global_symbol_pipe is empty on illumos (configure detection fails),
which causes export_symbols_cmds to generate broken pipelines like:
  nm ... |  | sed ...
The empty pipe segment causes a syntax error.

--- a/gettext-runtime/intl/Makefile.in
+++ b/gettext-runtime/intl/Makefile.in
@@ -2411,7 +2411,6 @@
 OTHER_LDFLAGS = \
   @LTLIBICONV@ @INTL_MACOSX_LIBS@ $(INTL_WINDOWS_LIBS) @LIB_SETLOCALE_NULL@ @LTLIBTHREAD@ \
   -no-undefined \
-  -export-symbols-regex '^([^_]|_[^l]|_l[^i]|_li[^b]|_lib[^i]|_libi[^n]|_libin[^t]|_libint[^l]|_libintl[^_]).*' \
   -version-info $(LTV_CURRENT):$(LTV_REVISION):$(LTV_AGE) \
   -rpath $(libdir)

--- a/gettext-runtime/libasprintf/Makefile.in
+++ b/gettext-runtime/libasprintf/Makefile.in
@@ -1681,7 +1681,7 @@
 # How to build libasprintf.
 # With libtool 1.5.14, on some platforms, like BeOS, "libtool --tag=CXX" fails
 # to create a shared library, however "libtool --tag=CC" succeeds.
-libasprintf_la_LDFLAGS = @LTNOUNDEF@ -export-symbols-regex $(LIBASPRINTF_EXPORTED_SYMBOLS_REGEX)
+libasprintf_la_LDFLAGS = @LTNOUNDEF@

 # Documentation.

--- a/gettext-tools/libgettextpo/Makefile.in
+++ b/gettext-tools/libgettextpo/Makefile.in
@@ -4737,8 +4737,6 @@
 libgettextpo_la_LDFLAGS = -version-info \
 	$(LTV_CURRENT):$(LTV_REVISION):$(LTV_AGE) -rpath $(libdir) \
 	$(LTLIBUNISTRING) @LTLIBINTL@ @LTLIBICONV@ -lc -no-undefined \
-	-export-symbols-regex \
-	'^([^l]|l[^i]|li[^b]|lib[^g]|libg[^e]|libge[^t]|libget[^t]|libgett[^e]|libgette[^x]|libgettex[^t]|libgettext[^p]|libgettextp[^o]|libgettextpo[^_]|libgettextpo_version).*' \
 	$(am__append_2) $(am__append_3) $(am__append_4)
 @WOE32_FALSE@WOE32_LIBADD =
 @WOE32_TRUE@WOE32_LIBADD = libgettextpo.res.lo
