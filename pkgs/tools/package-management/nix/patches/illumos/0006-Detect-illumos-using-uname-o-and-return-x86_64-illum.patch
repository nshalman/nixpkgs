From 036bcb9a27bf52a6c3ba271a6170d3ff3fcc4077 Mon Sep 17 00:00:00 2001
From: Nahum Shalman <nshalman@edgecast.io>
Date: Fri, 11 Jul 2025 01:59:37 +0000
Subject: [PATCH] Detect illumos using uname -o and return x86_64-illumos
 system string

---
 src/libstore/meson.build | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/libstore/meson.build b/src/libstore/meson.build
index 65a4e6aa8..7b3937338 100644
--- a/src/libstore/meson.build
+++ b/src/libstore/meson.build
@@ -33,6 +33,15 @@ configdata_priv.set_quoted(
 subdir('nix-meson-build-support/default-system-cpu')
 
 # Used in public header.
+# Detect illumos vs other SunOS systems using uname -o
+nix_system = host_machine.system()
+if nix_system == 'sunos'
+  uname_o = run_command('uname', '-o', check: false)
+  if uname_o.returncode() == 0 and uname_o.stdout().strip() == 'illumos'
+    nix_system = 'illumos'
+  endif
+endif
+
 configdata_pub.set_quoted(
   'NIX_LOCAL_SYSTEM',
   nix_system_cpu + '-' + host_machine.system(),
-- 
2.50.1

