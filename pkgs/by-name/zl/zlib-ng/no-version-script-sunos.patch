zlib-ng: do not pass a GNU version script to the linker on SunOS

The illumos link-editor has no --version-script option (it takes symbol
versions from a mapfile with -M, and there an unmatched name becomes an
undefined reference, not a no-op), so linking the shared library fails with
"ld: fatal: unrecognized option '--version-script'". Skip symbol versioning
on SunOS the way the build already does on AIX; the library then exports its
symbols unversioned.

--- a/CMakeLists.txt	2026-09-22 17:28:51.958838332 -0400
+++ b/CMakeLists.txt	2026-09-22 17:28:52.915869172 -0400
@@ -1476,7 +1476,7 @@
         if(HAVE_NO_INTERPOSITION)
             set_target_properties(zlib-ng PROPERTIES COMPILE_FLAGS "-fno-semantic-interposition")
         endif()
-        if(NOT APPLE AND NOT CMAKE_SYSTEM_NAME STREQUAL AIX)
+        if(NOT APPLE AND NOT CMAKE_SYSTEM_NAME STREQUAL AIX AND NOT CMAKE_SYSTEM_NAME STREQUAL SunOS)
             if(NOT ZLIB_COMPAT)
                 add_definitions(-DHAVE_SYMVER)
             endif()
